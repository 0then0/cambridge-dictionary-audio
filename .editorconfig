root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Match Biome and the repository's YAML/JSON/web source conventions.
[*.{json,jsonc,yml,yaml,js,mjs,cjs,jsx,ts,tsx,css,html,xml,svg,plist}]
indent_size = 2

[*.sh]
indent_size = 2

# Preserve Markdown hard line breaks and existing paragraph wrapping.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf

[{Makefile,makefile,GNUmakefile}]
indent_style = tab
